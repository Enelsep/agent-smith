# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so it
# must never hold a real key.
#
# Key discovery is provider-agnostic: the prefix is derived from the endpoint
# passed as `--provider-url`, so any OpenAI-compatible provider works by using
# its own name. `MISTRAL_API_KEY` or `TOGETHER_API_KEY` need no code change.

# --- The name we look for first, one key ---
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Several keys for one provider, for the CORE-2 rotation pool ---
# Numbered from 2 up. A hole in the sequence skips that key only; the ones
# after it are still picked up.
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# --- Or the same thing on one line, comma-separated ---
GROQ_API_KEYS=

# --- Last-resort names, used only when nothing above matched ---
# Most specific first: a bare API_KEY in a shared .env could belong to any
# service, so LLM_API_KEY wins when both are set.
LLM_API_KEY=
API_KEY=
